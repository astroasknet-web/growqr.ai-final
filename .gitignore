node_modules
old-reference
docs/
crm-docs/
.next
out
build
dist
.DS_Store
*.log
.env*
!.env.example
.vercel
next-env.d.ts

# TypeScript build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local Claude Code config
.claude/settings.local.json

# Camera masters dropped into public/ for transcoding. Matched by the phone's
# IMG_ prefix, not by extension case: core.ignorecase is true here, so a
# `*.MP4` pattern would also swallow the lowercase web copies the site really
# serves (growqr-demo.mp4 and friends). No .mov is ever served, so that one
# stays broad. The multi-hundred-MB originals must never be committed.
public/*.mov
public/IMG_*.mp4
# Git matches the line above case-insensitively (core.ignorecase), but the
# Vercel CLI's ignore matcher does not — without this second line it uploads
# the 318MB IMG_2517.MP4 master and the deploy dies on the 100MB per-file cap.
public/IMG_*.MP4

# Gallery working set. `npm run gallery:build` regenerates every one of these
# from public/Event Photos/ (which IS tracked), so committing them would put a
# second and third copy of ~200MB of photography in the repo. The written
# curation report and the machine-readable decision list are kept, since those
# are the record of what was cut and why.
gallery-assets/*
!gallery-assets/review/
gallery-assets/review/*
!gallery-assets/review/CURATION.md
!gallery-assets/review/curation-index.json

# Intermediate JPEGs for the gallery deck; regenerated by gallery:deck.
.gallery-deck-cache/

# Demo and preview documents generated by emails:preview / letter:preview.
# Regenerated on demand from the real templates, and not for public serving.
public/internal/

# OS and editor metadata. .DS_Store is already covered above; these are the
# rest of the debris that accumulates in a working copy and has never belonged
# in a commit.
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Merge leftovers, editor backups and scratch files. These look like source to
# a `git add .`, which is exactly how a half-resolved conflict gets committed.
*.bak
*.orig
*.rej
*.tmp
*~

# Tooling caches and test/coverage output. All regenerated on the next run.
.eslintcache
.turbo/
coverage/
.nyc_output/
.vitest/

# Package-manager debug dumps. `*.log` above catches these, but naming them
# makes the intent explicit rather than incidental.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
