{"sutras":[{"n":1,"sanskrit":"एकाधिकेन पूर्वेण","translit":"Ekadhikena Purvena","meaning":"By one more than the previous one"},{"n":2,"sanskrit":"निखिलं नवतश्चरमं दशतः","translit":"Nikhilam Navatashcaramam Dashatah","meaning":"All from 9 and the last from 10"},{"n":3,"sanskrit":"ऊर्ध्वतिर्यग्भ्याम्","translit":"Urdhva-Tiryagbhyam","meaning":"Vertically and cross-wise"},{"n":4,"sanskrit":"परावर्त्य योजयेत्","translit":"Paravartya Yojayet","meaning":"Transpose and apply"},{"n":5,"sanskrit":"शून्यं साम्यसमुच्चये","translit":"Shunyam Saamyasamuccaye","meaning":"If the Samuccaya is the same, it is zero"},{"n":6,"sanskrit":"आनुरूप्ये शून्यमन्यत्","translit":"Anurupyena Shunyamanyat","meaning":"If one is in ratio, the other is zero"},{"n":7,"sanskrit":"संकलनव्यवकलनाभ्याम्","translit":"Sankalana-vyavakalanabhyam","meaning":"By addition and by subtraction"},{"n":8,"sanskrit":"पूरणापूरणाभ्याम्","translit":"Puranapuranabhyam","meaning":"By the completion or non-completion"},{"n":9,"sanskrit":"चलनकलनाभ्याम्","translit":"Chalana-Kalanabhyam","meaning":"Differences and similarities"},{"n":10,"sanskrit":"यावदूनम्","translit":"Yavadunam","meaning":"Whatever the extent of its deficiency"},{"n":11,"sanskrit":"व्यष्टिसमष्टिः","translit":"Vyashti Samashti","meaning":"Part and whole"},{"n":12,"sanskrit":"शेषाण्यङ्केन चरमेण","translit":"Shesanyankena Charamena","meaning":"The remainders by the last digit"},{"n":13,"sanskrit":"सोपान्त्यद्वयमन्त्यम्","translit":"Sopaantyadvayamantyam","meaning":"The ultimate and twice the penultimate"},{"n":14,"sanskrit":"एकन्यूनेन पूर्वेण","translit":"Ekanyunena Purvena","meaning":"By one less than the previous one"},{"n":15,"sanskrit":"गुणितसमुच्चयः","translit":"Gunitasamuccayah","meaning":"The product of the sum is the sum of the products"},{"n":16,"sanskrit":"गुणकसमुच्चयः","translit":"Gunakasamuccayah","meaning":"The factors of the sum is the sum of the factors"}],"subSutras":[{"n":1,"translit":"Anurupyena","meaning":"Proportionately"},{"n":2,"translit":"Shishyate Shesasamjnah","meaning":"The remainder remains constant"},{"n":3,"translit":"Adyamadyenantya Mantyena","meaning":"The first by the first and the last by the last"},{"n":4,"translit":"Kevalaih Saptakam Gunyat","meaning":"For 7 the multiplicand is 143"},{"n":5,"translit":"Veshtanam","meaning":"By osculation"},{"n":6,"translit":"Yavadunam Tavadunam","meaning":"Whatever the deficiency, lessen it still further"},{"n":7,"translit":"Yavadunam Tavadunikritya Vargam Cha Yojayet","meaning":"Lessen the deficiency and set up the square"},{"n":8,"translit":"Antyayordasake'pi","meaning":"The sum of the last digits is 10"},{"n":9,"translit":"Antyayoreva","meaning":"Only the last terms"},{"n":10,"translit":"Samuccayagunitah","meaning":"The sum of the coefficients in the product"},{"n":11,"translit":"Lopana-Sthapanabhyam","meaning":"By alternate elimination and retention"},{"n":12,"translit":"Vilokanam","meaning":"By mere observation"},{"n":13,"translit":"Gunitasamuccayah Samuccayagunitah","meaning":"Product of coefficient-sums equals the coefficient-sum of the product"}],"levels":[{"n":1,"name":"Foundation","tag":"Beginner · Ages 8–12","hours":"40–50 hours","emoji":"🌱","blurb":"Build rock-solid mental arithmetic — base systems, lightning multiplication, division, squares and verification."},{"n":2,"name":"Intermediate","tag":"Class 6–10 · Ages 12–16","hours":"50–60 hours","emoji":"🚀","blurb":"Scale the sutras to large numbers, algebra, geometry, trigonometry and number theory."},{"n":3,"name":"Advanced","tag":"Competitive · Age 16+","hours":"60–70 hours","emoji":"🏆","blurb":"Apply Vedic methods to higher algebra, calculus, matrices, statistics and exam strategy."}],"modules":[{"num":1,"level":1,"slug":"module-1","title":"Introduction to Vedic Mathematics","sutra":"Conceptual Overview — all 16 Sutras","topics":["History & origin (Atharvaveda, Swami Bharati Krishna Tirtha)","Conventional vs Vedic methods","The 16 Sutras & 13 Sub-Sutras","The Base system (10, 100, 1000)",