anation":"5(x + 2).","section":"logical-reasoning","difficulty":"easy"},{"q":"Factorise 6x + 9.","options":["3(2x + 3)","2(3x + 9)","3(2x + 9)","6(x + 9)"],"correct":0,"explanation":"HCF is 3: 3(2x + 3).","section":"mathematical-reasoning","difficulty":"easy"},{"q":"Factorise x² − 9.","options":["(x + 3)(x − 3)","(x − 3)²","(x + 3)²","(x + 9)(x − 1)"],"correct":0,"explanation":"Difference of squares.","section":"mathematical-reasoning","difficulty":"medium"},{"q":"Factorise x² + 6x + 9.","options":["(x + 3)²","(x − 3)²","(x + 6)(x + 3)","(x + 9)(x + 1)"],"correct":0,"explanation":"Perfect square: (x + 3)².","section":"mathematical-reasoning","difficulty":"medium"},{"q":"Factorise x² + 5x + 6.","options":["(x + 2)(x + 3)","(x + 1)(x + 6)","(x + 2)(x + 4)","(x + 5)(x + 1)"],"correct":0,"explanation":"2 × 3 = 6 and 2 + 3 = 5.","section":"mathematical-reasoning","difficulty":"medium"},{"q":"Factorise x² − 16.","options":["(x + 4)(x − 4)","(x − 4)²","(x + 8)(x − 2)","(x + 4)²"],"correct":0,"explanation":"Difference of squares.","section":"mathematical-reasoning","difficulty":"medium"},{"q":"Divide 12x³ by 3x.","options":["4x","4x²","9x²","4x³"],"correct":1,"explanation":"12 ÷ 3 = 4 and x³ ÷ x = x², so 4x².","section":"mathematical-reasoning","difficulty":"medium"},{"q":"A rectangle has area x² + 7x + 12. Its sides could be ___ ?","options":["(x + 3) and (x + 4)","(x + 2) and (x + 6)","(x + 1) and (x + 12)","(x + 5) and (x + 2)"],"correct":0,"explanation":"x² + 7x + 12 = (x + 3)(x + 4).","section":"everyday-math","difficulty":"medium"},{"q":"Factorise 8x + 12.","options":["4(2x + 3)","2(4x + 12)","4(2x + 12)","8(x + 12)"],"correct":0,"explanation":"HCF is 4: 4(2x + 3).","section":"everyday-math","difficulty":"easy"},{"q":"Factorise x² + 7x + 10.","options":["(x + 2)(x + 5)","(x + 1)(x + 10)","(x + 3)(x + 4)","(x + 7)(x + 1)"],"correct":0,"explanation":"2 × 5 = 10 and 2 + 5 = 7.","section":"achievers","difficulty":"hard"},{"q":"Factorise x² − x − 6.","options":["(x − 3)(x 