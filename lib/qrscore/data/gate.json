    "other": [
        {
            "label": "cover letter",
            "patterns": [
                "dear (?:hiring|sir|madam|mr|ms|mrs|team|recruit|admission)",
                "yours (?:sincerely|faithfully)",
                "i am writing to (?:apply|express|submit|enquire)",
                "(?:please find|enclosed|attached)[^.]{0,40}(?:resume|cv|curriculum)",
                "i would (?:welcome|appreciate) the opportunity",
                "kind regards",
                "thank you for (?:your|considering)",
                "look forward to (?:hearing|your)"
            ],
            "need": 2
        },
        {
            "label": "invoice, receipt or bank statement",
            "patterns": [
                "invoice (?:no|number|date)",
                "bill to",
                "gstin",
                "sub-?total",
                "grand total",
                "amount due",
                "tax invoice",
                "receipt (?:no|number)",
                "ifsc",
                "account (?:no|number|statement)",
                "opening balance",
                "closing balance",
                "transaction (?:id|date)",
                "payment (?:received|due|terms)",
                "purchase order",
                "qty"
            ],
            "need": 3
        },
        {
            "label": "research paper or article",
            "patterns": [
                "abstract",
                "keywords?\\s*[:\\-]",
                "references",
                "et al\\b",
                "doi\\s*[:.]",
                "introduction",
                "methodology",
                "literature review",
                "conclusions?",
                "fig(?:ure)?\\.? \\d",
                "results and discussion",
                "copyright"
            ],
            "need": 4
        },
        {
            "label": "contract or legal document",
            "patterns": [
                "hereby",
                "whereas",
                "party of the (?:first|second) part",
                "terms and conditions",
                "governing law",
                "indemnif",
                "witnesseth",
                "this agreement",
                "jurisdiction",
                "clause \\d",
                "notwithstanding",
                "privacy policy"
            ],
            "need": 3
        },
        {
            "label": "question paper or worksheet",
            "patterns": [
                "time allowed",
                "maximum marks",
                "answer all (?:the )?questions",
                "section [a-d]\\b",
                "q\\.? ?\\d+[.)]",
                "\\[\\d+ marks?\\]",
                "\\(\\d+ marks?\\)",
                "choose the correct",
                "multiple choice",
                "fill in the blanks",
                "general instructions",
                "solve the following",
                "class[- ]?(?:\\d+|[ivx]+) ?(?:worksheet|test|exam)"
            ],
            "need": 2
        },
        {
            "label": "book chapter or study notes",
            "patterns": [
                "chapter \\d+",
                "table of contents",
                "exercise \\d",
                "theorem",
                "lemma",
                "proof\\.",
                "example \\d",
                "summary of the chapter",
                "learning objectives",
                "key terms",
                "worked example",
                "solution\\s*[:.]",
                "unit \\d"
            ],
            "need": 3
        },
        {
            "label": "job description",
            "patterns": [
                "job description",
                "we are looking for",
                "about (?:the company|us|the role)",
                "apply now",
                "(?:required|preferred|minimum) qualifications",
                "what we offer",
                "who you are",
                "how to apply",
                "equal opportunity employer",
                "the ideal candidate",
                "joining us"
            ],
            "need": 2
        },
        {
            "label": "certificate or marksheet",
            "patterns": [
                "this is to certify",
                "certificate of (?:completion|achievement|participation|appreciation|merit)",
                "marks obtained",
                "statement of marks",
                "grade card",
                "hall ticket",
                "admit card",
                "roll (?:no|number)",
                "seat (?:no|number)",
                "result (?:declared|sheet)",
                "registration (?:no|number)",
                "enrol(?:l)?ment (?:no|number)",
                "has successfully completed",
                "awarded to",
                "controller of examinations"
            ],
            "need": 3
        },
        {
            "label": "offer, experience or recommendation letter",
            "patterns": [
                "we are pleased to offer",
                "date of joining",
                "\\bctc\\b",
                "annexure",
                "this is to certify that (?:mr|ms|mrs|shri|smt)",
                "was employed with",
                "to whom it may concern",
                "i am pleased to recommend",
                "recommend (?:him|her|them)",
                "relieving letter",
                "experience (?:letter|certificate)"
            ],
            "need": 2
        },
        {
            "label": "formal letter or application",
            "patterns": [
                "^\\s*(?:subject|sub)\\s*[:\\-]",
                "respected (?:sir|madam)",
                "thanking you",
                "yours (?:faithfully|sincerely|truly|obediently)",
                "i request you",
                "kindly (?:consider|do the needful|grant|allow)",
                "with reference to",
                "ref(?:erence)?\\.? ?no",
                "^\\s*to\\s*,?\\s*$",
                "with regards",
                "dear "
            ],
            "need": 2
        },
        {
            "label": "application or visa form",
            "patterns": [
                "application form",
                "purpose of (?:journey|visit|travel)",
                "applicant'?s? (?:name|signature|details)",
                "signature of (?:the )?(?:applicant|candidate|parent|guardian)",
                "for office use",
                "affidavit",
                "visa (?:application|type|category|fee)",
                "tick (?:the )?(?:box|appropriate)",
                "declaration by",
                "details of (?:the )?applicant",
                "passport (?:no|number)[^.]{0,80}(?:place|country) of (?:issue|birth)"
            ],
            "need": 3
        },
        {
            "label": "salary slip",
            "patterns": [
                "basic pay",
                "\\bhra\\b",
                "net pay",
                "gross earnings",
                "total deductions",
                "professional tax",
                "\\bpf\\b",
                "payslip|salary slip"
            ],
            "need": 3
        },
        {
            "label": "course outline or syllabus",
            "patterns": [
                "prerequisites?",
                "learning outcomes",
                "module \\d",
                "week \\d",
                "lesson \\d",
                "syllabus",
                "curriculum",
                "course (?:code|duration|outline|overview)",
                "who this course is for",
                "what you(?:'ll| will) learn"
            ],
            "need": 2
        },
        {
            "label": "placeholder or sample text",
            "patterns": [
                "lorem ipsum",
                "dolor sit amet",
                "consectetur adipiscing",
                "the quick brown fox"
            ],
            "need": 1
        },
        {
            "label": "source code or data file",
            "patterns": [
                "\\bfunction\\s*\\(",
                "\\bdef \\w+\\(",
                "#include",
                "\\bimport \\w+",
                "console\\.log",
                "public static void",
                "<\\/?(?:div|span|html|script)",
                "select .+ from ",
                "\\$\\w+\\s*=",
                "=>",
                "\\{\\s*$",
                ";\\s*$"
            ],
            "need": 5
        },
        {
            "label": "news, blog or essay",
            "patterns": [
                "said on (?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)",
                "according to",
                "in this (?:article|post|essay)",
                "subscribe",
                "share this",
                "read more",
                "posted (?:on|by)",
                "comments? \\(\\d+\\)",
                "breaking news",
                "photo:",
                "the government",
                "minister"
            ],
            "need": 3
        }
    ]
}