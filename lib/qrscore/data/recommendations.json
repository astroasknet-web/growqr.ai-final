{
  "_comment": "Recommendation engine data for GrowQR RQ Score, wired to the real Vidaara course catalog (https://vidaara.org/courses_new/). Course URL = base_url + course_path + slug. 'resume_rules' map education-section weaknesses to career-readiness courses; 'domains' map the candidate's detected field to upskilling courses; 'catalog' is the editable list of all 116 courses.",
  "base_url": "https://vidaara.org",
  "course_path": "/courses_new/",
  "max_total": 6,

  "resume_rules": [
    {
      "id": "resume-makeover",
      "when": { "section_below": 12 },
      "slug": "corporate-readiness-interview",
      "reason": "Your education section scores low on clarity and structure. This course covers resume building, ATS formatting and mock interviews to fix that fast."
    },
    {
      "id": "ats-formatting",
      "when": { "param_below": { "id": 15, "score": 3 } },
      "slug": "corporate-readiness-interview",
      "reason": "Layout hierarchy is weak. Resume-building sessions here rework spacing, bullets and typography so you read well to both ATS and humans."
    },
    {
      "id": "degree-wording",
      "when": { "param_below": { "id": 2, "score": 3 } },
      "slug": "business-communication",
      "reason": "Your degree is written informally or abbreviated. Professional-writing skills help you present credentials with precise, formal wording."
    },
    {
      "id": "positioning",
      "when": { "param_below": { "id": 4, "score": 3 } },
      "slug": "linkedin-personal-branding",
      "reason": "Your field/specialisation reads as broad. Personal-branding work sharpens how you position your background for target roles."
    },
    {
      "id": "certifications-early",
      "when": { "param_below": { "id": 11, "score": 2 }, "career_stage": ["student", "fresher"] },
      "slug": "corporate-readiness-interview",
      "reason": "Few professional certifications detected for an early-career profile. Get interview-ready and learn which credentials matter for your target roles."
    }
  ],

  "domain_recommendation": {
    "max": 3,
    "reason_template": "Based on your %DOMAIN% background, this Vidaara course builds job-ready, in-demand skills that strengthen your profile."
  },

