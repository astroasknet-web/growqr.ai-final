# Upload filter for `vercel deploy` from a laptop.
#
# The CLI falls back to .gitignore when this file is absent, but its matcher is
# case-sensitive where git's is not (core.ignorecase is true in this repo), so
# `public/IMG_*.mp4` alone let the 333MB IMG_2517.MP4 camera master into the
# upload and every deploy died on Vercel's 100MB per-file cap. This file mirrors
# .gitignore and spells out the case variants and directory forms explicitly.
#
# Keep in sync with .gitignore when adding new ignore rules there.

node_modules
node_modules/
old-reference
docs
docs/
crm-docs
crm-docs/
.next
.next/
out
build
dist
.DS_Store
*.log
.env*
!.env.example
.vercel
.vercel/
.git
.git/
next-env.d.ts

# TypeScript build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local Claude Code config
.claude
.claude/

# Camera masters dropped into public/ for transcoding. Both extension cases,
# since the CLI will not fold them together. The web copies the site actually
# serves (growqr-demo.mp4 and friends) carry no IMG_ prefix, so they survive.
public/*.mov
public/*.MOV
public/IMG_*.mp4
public/IMG_*.MP4

# Gallery working set — regenerated by `npm run gallery:build`, never served.
gallery-assets
gallery-assets/

# Repo-only handover documents. Tracked in git for the next owner, never served.
HANDOVER.html
HANDOVER.pdf
HANDOVER.docx
