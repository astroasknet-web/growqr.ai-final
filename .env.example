# ─────────────────────────────────────────────────────────────
# GrowQR website — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Vars prefixed NEXT_PUBLIC_ are exposed
# to the browser, so only put non-secret/public values there.
# ─────────────────────────────────────────────────────────────

# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, full access — keep secret

# Resend (transactional + invoice emails)
RESEND_API_KEY=your-resend-api-key

# Where the internal "new internship application" alert is sent. Defaults to
# hello@growqr.ai (the careers inbox) when unset.
INTERNSHIP_HIRING_EMAIL=

# Cloudflare Turnstile (bot protection on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Google Analytics 4 measurement ID. GA4 is entirely disabled (no script
# loaded) when this is unset or malformed — no hardcoded fallback ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-RTZRGK7DRE

# Zoho SalesIQ website widget code (starts with "siq").
# Find it in SalesIQ: Settings > Brands > Installation > Website.
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=siq_your_widget_code

# SalesIQ webhook bot auth — app/api/salesiq/bot/route.ts accepts EITHER proof.
#
# 1. SALESIQ_PUBLIC_KEY (the real one). The bot has webhook.secured = true, so
#    SalesIQ signs each request body with its private key and sends the
#    signature as x-siqsignature. Paste the bot's public key here — bare
#    base64 or full PEM, both accepted. Read it from the SalesIQ console, or:
#      GET https://salesiq.zoho.in/api/v2/<portal>/bots/<botId>  →  webhook.keys[].public_key
SALESIQ_PUBLIC_KEY=

# 2. SALESIQ_WEBHOOK_SECRET — shared secret compared against a custom
#    x-growqr-bot header. SalesIQ does NOT send custom headers on the current
#    bot config (verified 2026-08-01: webhook.headers is absent), so this
#    cannot be the only gate. Kept for the case where headers are configured.
SALESIQ_WEBHOOK_SECRET=generate-a-long-random-value

# Zoho never documented the x-siqsignature digest or encoding, so verification
# probes a short candidate list and logs which matched. After one verified live
# request, pin it here to make the check deterministic (e.g. RSA-SHA256:base64).
SALESIQ_SIGNATURE_ALGO=

# Set to "observe" to log auth failures and PROCEED instead of returning 401.
# One-request diagnostic only, for pinning the signature variant above.
# Never leave this set in production.
SALESIQ_AUTH_MODE=

# Admin access into /admin is authorized entirely in Supabase — grant a user
# access by setting app_metadata { "is_admin": true } on their auth account
# (service role only, e.g. via the Supabase dashboard or Admin API). No env
# var needed here.

# Google Calendar OAuth (Expert Booking) — from Google Cloud OAuth client.
# GOOGLE_OAUTH_REDIRECT_URI must EXACTLY match an Authorized redirect URI;
# use the localhost value for local dev, the deployed value in production.
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# Leave unset. /api/google/connect + /api/google/callback 404 unless this is
# exactly "true". Completing consent REPLACES the stored refresh token, so
# whoever finishes the flow last owns every future Meet link. Set to "true" only
# while reconnecting a calendar, then unset it again.
# GOOGLE_CONNECT_ENABLED=true

# Calendar id for internship final-round interviews. A secondary calendar under
# the connected (support) account, so those meetings sit apart from expert
# bookings and HR can watch just that one. Leave unset to fall back to the
# account's primary calendar. Find the id in Google Calendar settings for the
# calendar (Integrate calendar > Calendar ID), usually ...@group.calendar.google.com.
INTERNSHIP_CALENDAR_ID=

# Razorpay — payment keys. Use rzp_test_* for test mode, rzp_live_* for prod.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Secures BOTH scheduled jobs — /api/cron/crm-sync and /api/cron/expert-reminders
# (Vercel Cron sends it as a Bearer token). Fails closed: when this is unset the
# routes refuse to run rather than executing unauthenticated.
CRON_SECRET=generate-a-long-random-string

# Distributed rate limiting (lib/rate-limit.ts). OPTIONAL: when BOTH are set the
# API rate limiter uses Upstash Redis, which is shared across all Vercel
# serverless instances. When unset (local dev, or a deploy without Upstash) it
# transparently falls back to a per-instance in-memory limiter — no code change,
# nothing breaks, just a weaker ceiling. Create a free Redis DB at
# https://upstash.com and copy its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# SalesIQ bot AI fallback (lib/ai/, lib/bot/router.ts handleFallback)
# See docs/salesiq-bot/AI_FALLBACK_DESIGN.md.
#
# The KB (lib/bot/answers.ts) stays the sole source of truth for facts about
# GrowQR — pricing, features, policies. This layer only improves conversation
# quality on the simple/generic remainder the deterministic layer can't answer
# (e.g. "how's it going", "can someone contact me"), and never states a
# product fact without citing the KB article it came from — see
# lib/ai/guards.ts for the enforcement.
# ─────────────────────────────────────────────────────────────

# Master switch. false/unset: a KB/FAQ miss goes straight to human handoff
# (today's original behaviour). true: tries a grounded-or-conversational AI
# reply first, per the hierarchy above, still logged to bot_unanswered either way.
BOT_AI_ENABLED=false

OPENAI_API_KEY=your-openai-api-key
# Falls back to gpt-4.1 (a non-reasoning model — the webhook has a hard
# 5-second budget, and reasoning tokens add latency variance) if unset.
OPENAI_MODEL=gpt-4.1

# ─────────────────────────────────────────────────────────────
# GrowQR interview-assignment API (lib/internship/growqr-interview-api.ts)
# Assigns AI interviews to internship candidates and polls their results.
# See docs/growqr-app/INTERVIEW_SERVICE_INTEGRATION.md.
#
# Both are issued together by GrowQR, per integration. When either is unset,
# interviewApiConfigured() is false and the interview card falls back to HR
# entering rounds and outcomes by hand.
# ─────────────────────────────────────────────────────────────

# Bearer service key for api.growqr.ai. Backend only, never expose to a browser.
GROWQR_INTERVIEW_API_KEY=
# The organization_id assignments and results are scoped to. A wrong value
# returns zero results with no error, so it must match what GrowQR issued.
GROWQR_INTERVIEW_ORG_ID=

# ─────────────────────────────────────────────────────────────
# Zoho CRM (lib/crm/*)
# Full runbook: lib/crm/README.md — read it before changing anything here.
#
# Website form submissions become Zoho Leads. Sync runs twice: inline right
# after the response, and again on the nightly cron as the durability layer.
# ─────────────────────────────────────────────────────────────

# Self-client credentials from the Zoho API console.
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# Refresh tokens carry the scopes they were minted with — there is no "add a
# scope later" call. Widening access means minting a new one (npm run zoho:token).
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
# Data-centre bases. India is .in; a mismatch here fails auth with a confusing
# INVALID_CODE rather than a region error.
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_API_BASE=https://www.zohoapis.in

# Master kill switch for every Zoho write. Compared with strict equality to the
# string "true" — "TRUE" and "1" both leave sync disabled. When off, rows still
# queue as pending and drain once it is switched back on, so nothing is lost.
CRM_SYNC_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Cal.com demo bookings (lib/cal/*)
# ─────────────────────────────────────────────────────────────

# Cal signs the complete raw request body with HMAC-SHA256. Fails closed: unset
# means every webhook delivery is rejected with 401. GET /api/cal/webhook is a
# liveness probe that reports whether this is configured.
CAL_WEBHOOK_SECRET=your-cal-webhook-secret

# ─────────────────────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────────────────────

# Base URL for the GrowQR platform API (interview assignment + results).
# Defaults to https://api.growqr.ai when unset.
GROWQR_API_URL=https://api.growqr.ai

# User service, read by the public-profile reader that prefills the internship
# form. Defaults to https://api.growqr.ai/users/api/v1 when unset.
GROWQR_USER_API_URL=https://api.growqr.ai/users/api/v1

# Public base for the GrowQR app. Used to build candidate-facing links — the AI
# assessment URL in interview invites, and profile links. Defaults to
# https://app.growqr.ai when unset.
NEXT_PUBLIC_GROWQR_APP_URL=https://app.growqr.ai

# Local override for the geo-detected country, so currency, pricing and the
# live/not-live market gating can be tested without a VPN. Two-letter code.
# Never set this in production — it overrides the real visitor's location.
FORCE_COUNTRY=

# Legacy escape hatch that pins only the displayed CURRENCY, leaving the
# detected country (and therefore the live/not-live gating) alone. Prefer
# FORCE_COUNTRY, which moves both together. Never set in production.
FORCE_CURRENCY=

# Blocks search engines from the whole deployment: robots.txt becomes a blanket
# "Disallow: /" and every response gains "X-Robots-Tag: noindex, nofollow".
# Set to exactly "true" on non-production Vercel projects ONLY — currently
# growqr-india-demo (growqrinview.vercel.app), which serves an identical copy of
# the site on a crawlable host and so competes with www.growqr.ai in the index.
# Fail-open by design: anything other than "true" (including unset) leaves the
# site fully indexable, so a typo can never de-index production.
SEO_BLOCK_INDEXING=

# ─────────────────────────────────────────────────────────────
# BlogForge Engine (headless blog + SEO — the separate Node/MySQL engine).
# The /blog pages fetch posts from the engine's REST API. OPTIONAL: when unset
# the /blog pages show a "coming soon" state (lib/blog/blogforge.ts). Set all
# four to light the blog up — no code change.
#   Server-only (used to fetch posts):
BLOGFORGE_API_URL=            # e.g. https://blog-engine.growqr.ai  (the engine's BASE_URL)
BLOGFORGE_API_KEY=            # the GrowQR site's key from the engine admin (pk_...)
#   Public (used by the analytics beacon js/track.js in the browser):
NEXT_PUBLIC_BLOGFORGE_URL=    # same engine URL, exposed to the client for track.js
NEXT_PUBLIC_BLOGFORGE_SITE_SLUG=   # the GrowQR site's public slug in the engine

# ─────────────────────────────────────────────────────────────
# Portal accounts (students, employers, staff). Same database as the PHP app.
# ─────────────────────────────────────────────────────────────
# Postgres connection string. Supabase: Project Settings > Database > Connection string (the pooler "session mode" string).
# Server-side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# "disable" for a local database; "verify" to fully verify the server certificate. Default: encrypted, certificate not verified.
DATABASE_SSL=
# Session time zone for the database connection. Must equal the zone the PHP app uses while both run on the same data. Default UTC.
DB_TIMEZONE=
# Public address used in emailed links (verify email, reset password), e.g. https://www.growqr.ai
PORTAL_APP_URL=
# Sender for account emails (the domain must be verified in Resend). Default: GrowQR <no-reply@growqr.ai>
PORTAL_MAIL_FROM=
# Staff must use two-step login. Set to "false" ONLY on a developer machine.
PORTAL_MFA_REQUIRE_STAFF=
# "off" to skip the Turnstile check on account forms (it is on whenever NEXT_PUBLIC_TURNSTILE_SITE_KEY is set).
PORTAL_CAPTCHA=

# ─────────────────────────────────────────────────────────────
# Skill Passport (QR-verifiable credentials)
# ─────────────────────────────────────────────────────────────
# Signing seed, 32+ random characters. Use the SAME value the PHP app uses (passport.signing_seed in its config.php, or the contents of
# its storage/passport-signing.key) and both apps sign with one key, so every passport already issued keeps verifying. Keep it secret;
# if it is lost, passports can still be verified but new ones cannot be signed with the old key.
PASSPORT_SIGNING_SEED=

# ─────────────────────────────────────────────────────────────
# Resume Studio (45 templates, Pro plan)
# ─────────────────────────────────────────────────────────────
# Razorpay keys (the same ones the PHP app uses). Without them the "Pay" button is replaced by a "switched on soon" note.
# RAZORPAY_KEY_ID may be left empty when NEXT_PUBLIC_RAZORPAY_KEY_ID is set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from the Razorpay dashboard. Webhook URL to register: https://<your-domain>/api/studio/webhook
# (events: payment.captured, order.paid). It replaces the PHP app's studio-webhook.php at cut-over.
RAZORPAY_WEBHOOK_SECRET=
# Optional. Pro price in rupees (default 199), Pro period in days (default 36500 = lifetime) and the free plan's wait between saves in hours (default 24).
STUDIO_PRICE_INR=
STUDIO_PERIOD_DAYS=
STUDIO_COOLDOWN_HOURS=

# ─────────────────────────────────────────────────────────────
# Marketplace (internships, courses, employers)
# ─────────────────────────────────────────────────────────────
# Where applicants' resume files are kept. With NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set they go to private Supabase Storage
# buckets (same names as the PHP app: "resumes", "vault"); otherwise to this folder on disk (default ./storage). Never serve this folder publicly.
STORAGE_DIR=
# Email that is told when an employer submits a role for review (optional).
PORTAL_ADMIN_EMAIL=
# Courses are taught on Vidaara. "Open on Vidaara" links go to this base (default https://vidaara.org/courses_new/).
COURSES_BASE_URL=
# Students may only link certificates on these hosts (comma list, subdomains allowed). Default: vidaara.org
LMS_CERTIFICATE_HOSTS=
# Set a long random string to enable the signed completion callback POST /api/lms-webhook
# (headers X-Timestamp and X-Signature = hex HMAC-SHA256 of "<timestamp>.<raw body>"; body {"email","course_slug","certificate_url","certificate_code"}).
LMS_WEBHOOK_SECRET=

# Overseas CRM: the third-party document-verification fee the STUDENT pays (nothing is sent to the partner until it is paid).
# Fee = CRM_VERIFY_BASE_INR + CRM_VERIFY_PER_DOC_INR x number of documents (defaults 0 and 750). Name shown to staff and students:
CRM_VERIFY_PROVIDER=
CRM_VERIFY_BASE_INR=
CRM_VERIFY_PER_DOC_INR=
# Study-abroad and CRM uploads: scan with ClamAV (clamd over TCP) when set; otherwise the built-in heuristic scanner runs.
CLAMAV_HOST=
CLAMAV_PORT=

# The same CRON_SECRET also protects GET /api/cron/portal (mail queue, visa reminders, session cleanup).
# Where the e-book links on /go send people (default https://mathstudy.in).
MATHSTUDY_URL=
